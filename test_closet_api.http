@base_url = http://localhost:8000/api
@token = YOUR_JWT_ACCESS_TOKEN_HERE

###
# ITEM CATEGORIES API
###

# Get all item categories (user + parent's children if parent)
GET {{base_url}}/closet/item-category/
Authorization: Bearer {{token}}

###

# Create a new item category
POST {{base_url}}/closet/item-category/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "type": "Tops"
}

###
# CLOSET ITEMS API
###

# Get all closet items (user + parent's children if parent)
GET {{base_url}}/closet/items/
Authorization: Bearer {{token}}

###

# Create a new closet item
POST {{base_url}}/closet/items/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "category": 1,
    "name": "Blue Cotton Shirt",
    "brand": "Levis",
    "color": "Blue",
    "size": "M",
    "quantity": 1,
    "note": "A comfortable casual shirt.",
    "ai_detected": false
}
